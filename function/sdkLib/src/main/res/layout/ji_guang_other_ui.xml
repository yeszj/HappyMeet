<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vg_parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="@drawable/bg_login_bg">


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_phoneLogin"
        android:layout_width="@dimen/dp_54"
        android:layout_height="@dimen/dp_80"
        android:layout_marginStart="@dimen/dp_80"
        android:src="@drawable/svg_phone_login" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_wxLogin"
        android:layout_width="@dimen/dp_55"
        android:layout_height="@dimen/dp_79"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/dp_80"
        android:src="@drawable/svg_jiguang_wx_login" />
</RelativeLayout>
