<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="cn.huanyuan.sweetlove.ui.login.LoginViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/shape_bg_main"
            app:layout_constraintTop_toTopOf="parent" />

        <cn.yanhu.baselib.view.TitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_40"
            app:layout_constraintTop_toTopOf="parent"
            app:titleName=" " />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_55"
            android:text="密码登录"
            android:textColor="@color/fontTextColor"
            android:textSize="@dimen/sp_24"
            app:fontType="@string/fontMedium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleBar" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_40"
            android:layout_marginEnd="@dimen/dp_16"
            android:background="@drawable/common_shape_input_bg"
            android:hint="请输入手机号码"
            android:gravity="center_vertical"
            android:inputType="phone"
            android:maxLength="11"
            android:textSize="@dimen/sp_16"
            android:paddingHorizontal="@dimen/dp_15"
            android:text="@={viewModel.phoneExt}"
            android:textColor="@color/fontTextColor"
            android:textColorHint="@color/fontGrayColor"
            app:layout_constraintTop_toBottomOf="@+id/tv_phone" />

        <cn.yanhu.baselib.view.CustomFontEditText
            android:id="@+id/et_pwd"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_16"
            android:textSize="@dimen/sp_16"
            android:drawableEnd="@drawable/svg_eye_close"
            android:hint="请输入密码"
            android:text="@={viewModel.pwdExt}"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/dp_15"
            android:textColor="@color/fontTextColor"
            android:textColorHint="@color/fontGrayColor"
            android:background="@drawable/common_shape_input_bg"
            app:layout_constraintTop_toBottomOf="@+id/et_phone" />

        <cn.yanhu.baselib.view.CustomFontButton
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_40"
            android:layout_marginEnd="@dimen/dp_16"
            android:alpha="0.2"
            android:background="@drawable/white_corner_30"
            android:backgroundTint="@color/colorMain"
            android:enabled="false"
            android:text="下一步"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_17"
            app:fontType="@string/fontBold"
            app:layout_constraintTop_toBottomOf="@+id/et_pwd" />
        <LinearLayout
            android:id="@+id/connected_service"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/dp_30"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/dp_15"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <cn.yanhu.baselib.widget.FontWeightValueTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="联系客服"
                android:textColor="@color/fontTextColor"
                android:textSize="@dimen/sp_14" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:tint="@color/fontTextColor"
                android:src="@drawable/ic_service_icon" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>