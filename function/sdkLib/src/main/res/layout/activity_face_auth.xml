<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:colorBackground">

        <androidx.camera.view.PreviewView
            android:id="@+id/view_finder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="3:4" />

        <com.pcl.sdklib.sdk.faceAuth.Overlay
            android:id="@+id/overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingBottom="100dp"
            app:mask_color="?android:colorBackground"
            app:layout_constraintBottom_toBottomOf="@id/view_finder"
            app:layout_constraintEnd_toEndOf="@id/view_finder"
            app:layout_constraintStart_toStartOf="@id/view_finder"
            app:layout_constraintTop_toTopOf="@id/view_finder"
            app:target_restrict_area_shape="circle"
            app:target_restrict_circle_radius="150dp" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="100dp"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="?colorPrimary"
            app:indicatorSize="320dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:trackColor="#FF8091FF" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:textSize="@dimen/sp_16"
            android:textAppearance="?textAppearanceHeadline6"
            android:textColor="@color/cl_common_opacity_80"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progress"
            tools:text="这是一段文字" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/power_by"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@mipmap/powered_by" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>