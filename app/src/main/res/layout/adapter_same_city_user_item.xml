<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="userinfo"
            type="cn.yanhu.commonres.bean.SameCityUserInfo" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_85">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/avatarView"
            circleImageUrl="@{userinfo.portrait}"
            android:layout_width="@dimen/dp_66"
            android:layout_height="@dimen/dp_66"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/dp_12"
            android:src="@drawable/ease_default_avatar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <cn.yanhu.baselib.widget.FontWeightValueTextView
            android:id="@+id/tv_nickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_6"
            android:drawablePadding="@dimen/dp_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{userinfo.nickName}"
            android:textColor="@color/fontTextColor"
            android:textSize="@dimen/sp_15"
            app:fontWeightValue="medium"
            app:layout_constraintBottom_toTopOf="@+id/tv_userInfo"
            app:layout_constraintStart_toEndOf="@+id/avatarView"
            app:layout_constraintTop_toTopOf="@+id/avatarView"
            tools:text="佊岸、花开" />


        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_14"
            android:layout_marginStart="@dimen/dp_4"
            android:gravity="center"
            android:src="@drawable/icon_new_user"
            android:visibility="@{userinfo.newUser?View.VISIBLE:View.INVISIBLE}"
            app:fontType="@string/fontMedium"
            app:layout_constraintBottom_toBottomOf="@+id/tv_nickName"
            app:layout_constraintStart_toEndOf="@+id/tv_nickName"
            app:layout_constraintTop_toTopOf="@+id/tv_nickName" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_userInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:text="@{userinfo.strUserInfo}"
            android:textColor="@color/cl_common"
            android:textSize="@dimen/sp_12"
            app:layout_constraintBottom_toBottomOf="@id/avatarView"
            app:layout_constraintStart_toStartOf="@+id/tv_nickName"
            app:layout_constraintTop_toTopOf="@+id/avatarView"
            tools:text="女 | 32岁｜浙江｜老家黑龙江" />


        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp_10"
            android:layout_height="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_5"
            android:layout_marginBottom="@dimen/dp_5"
            android:src="@drawable/svg_online_stoke_white"
            android:visibility="@{userinfo.online?View.VISIBLE:View.INVISIBLE}"
            app:layout_constraintBottom_toBottomOf="@+id/avatarView"
            app:layout_constraintEnd_toEndOf="@+id/avatarView" />


        <LinearLayout
            android:id="@+id/vg_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:layout_marginEnd="@dimen/dp_15"
            android:background="@{userinfo.publicRoom?@drawable/bg_blinding_tag:(userinfo.privateRoom?@drawable/bg_private_tag:  @drawable/bg_friends_tag)}"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_7"
            android:paddingVertical="@dimen/dp_2"
            android:visibility="@{userinfo.roomId == 0? View.INVISIBLE : View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="@+id/avatarView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/avatarView"
            tools:background="@drawable/bg_blinding_tag">

            <com.opensource.svgaplayer.SVGAImageView
                android:id="@+id/svga_live"
                android:layout_width="@dimen/dp_14"
                android:layout_height="@dimen/dp_14"
                app:autoPlay="true"
                app:clearsAfterDetached="true"
                app:clearsAfterStop="true"
                app:loopCount="-1"
                app:source="play_white.svga" />

            <cn.yanhu.baselib.widget.FontWeightValueTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{userinfo.roomDesc}"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_11"
                app:fontWeightValue="medium"
                tools:text="交友中" />
        </LinearLayout>

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_intro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/dp_12"
            android:text='@{userinfo.description}'
            android:textColor="#BABABA"
            android:textSize="@dimen/sp_12"
            android:visibility="@{TextUtils.isEmpty(userinfo.description)?View.INVISIBLE:View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="@+id/avatarView"
            app:layout_constraintEnd_toStartOf="@+id/vg_room"
            app:layout_constraintStart_toEndOf="@+id/avatarView"
            app:layout_constraintTop_toBottomOf="@+id/tv_userInfo"
            tools:text="你认真的样子，你认真的样子你认真的样子你认真的样子" />

        <View
            android:id="@+id/picGridLayout"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_0_5"
            android:layout_marginTop="@dimen/dp_12"
            android:background="#14000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>