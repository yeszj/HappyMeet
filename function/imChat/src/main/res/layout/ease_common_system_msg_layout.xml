<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:layout_marginHorizontal="@dimen/dp_20"
    style="@style/chat_im_parent_style"
    android:orientation="vertical">

    <TextView
        android:id="@+id/timestamp"
        style="@style/chat_text_date_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/apply_friend_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_10"
        android:paddingHorizontal="@dimen/dp_15"
        android:background="@drawable/shape_item_un_select"
        android:paddingVertical="@dimen/dp_10"
        android:gravity="center"
        android:orientation="vertical"
        >

        <cn.yanhu.baselib.widget.FontWeightValueTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:textSize="@dimen/sp_14"
            android:text="对方已成功发送联系方式"
            android:textColor="@color/cl_common"
            app:fontWeightValue="bold"
            android:layout_marginBottom="@dimen/dp_5"
            android:layout_height="wrap_content"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_alert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="安全提醒：如对方要求添加外部聊天工具时（微信、QQ等）如涉及金钱相关，请保持警惕并及时举报，举报核实成功后可领取奖励。请谨防理财、裸聊、杀猪盘等诈骗，建议在平台内交友。"
            android:gravity="center"
            android:textColor="@color/cl_common_opacity_50"
            android:textSize="@dimen/sp_14" />


    </LinearLayout>

</LinearLayout>