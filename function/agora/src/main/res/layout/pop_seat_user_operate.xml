<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="userInfo"
            type="cn.yanhu.commonres.bean.UserDetailInfo" />

        <import type="android.view.View" />

        <variable
            name="isSelf"
            type="java.lang.Boolean" />

        <import type="android.text.TextUtils" />
        <import type="cn.yanhu.commonres.manager.AppCacheManager"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/viewBg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_40"
            android:background="@drawable/white_top_corner_15"
            app:layout_constraintBottom_toBottomOf="@+id/vg_operate"
            app:layout_constraintTop_toTopOf="parent" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_nickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/dp_15"
            android:text="@{userInfo.nickName}"
            android:textColor="@color/color_222222"
            android:textSize="@dimen/sp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_avatar"
            tools:text="忧伤开满来时路" />

        <cn.yanhu.commonres.view.UserInfoTagLayout
            android:id="@+id/vg_tag"
            userInfo="@{userInfo}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/dp_15"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_nickName" />

        <LinearLayout
            android:id="@+id/vg_relationInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_15"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vg_tag">

            <LinearLayout
                android:id="@+id/vg_guard"
                android:layout_width="@dimen/dp_120"
                android:layout_height="@dimen/dp_48"
                android:background="@drawable/bg_gradient_guard_btn"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="@{userInfo.guardInfo==null ||  userInfo.showGuardInfo?View.VISIBLE:View.GONE}">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:layout_marginStart="@dimen/dp_8"
                    android:src="@drawable/icon_tag_guard" />

                <cn.yanhu.baselib.view.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp_10"
                    android:text='@{TextUtils.isEmpty(userInfo.guardNickName)?"暂无守护":"守护\n"+userInfo.guardNickName}'
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_12"
                    app:fontType="@string/fontMedium"
                    tools:text="暂无守护" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vg_lovers"
                android:layout_width="@dimen/dp_120"
                android:layout_height="@dimen/dp_48"
                android:layout_marginStart="@dimen/dp_10"
                android:background="@{userInfo.loverInfo.loversType==3?@drawable/bg_lovers3_tag:userInfo.loverInfo.loversType==2?@drawable/bg_lovers2_tag:@drawable/bg_lovers1_tag}"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="@{userInfo.showLoverInfo?View.VISIBLE:View.GONE}"
                tools:background="@drawable/bg_lovers1_tag">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:layout_marginStart="@dimen/dp_8"
                    android:src="@{userInfo.loverInfo.loversType==3?@drawable/icon_lovers3:userInfo.loverInfo.loversType==2?@drawable/icon_lovers2:@drawable/icon_lovers1}"
                    tools:src="@drawable/icon_lovers2" />

                <cn.yanhu.baselib.view.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp_5"
                    android:text='@{TextUtils.isEmpty(userInfo.loverInfo.nickName)?"暂无情侣":userInfo.loverInfo.loverDesc()+"\n"+userInfo.loverInfo.nickName}'
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_12"
                    app:fontType="@string/fontMedium"
                    tools:text="黄金情侣\n琼(舞)" />
            </LinearLayout>
        </LinearLayout>


        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_20"
            android:paddingVertical="@dimen/dp_15"
            android:text="@{userInfo.description}"
            android:textColor="@color/color_888888"
            android:textSize="@dimen/sp_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vg_relationInfo"
            tools:text="有个姑娘问我借钱去整容，整的挺成功，我再没认出是谁问我借的钱。" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="@color/blackAlpha80"
            android:visibility="@{isSelf?View.GONE:View.VISIBLE}"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc" />

        <LinearLayout
            android:id="@+id/vg_operate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_55"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="@{isSelf?View.GONE:View.VISIBLE}"
            app:layout_constraintTop_toBottomOf="@+id/divider">

            <cn.yanhu.baselib.view.CustomFontTextView
                android:id="@+id/tv_alt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text='@{userInfo.gender==1?"@他":"@她"}'
                android:textColor="@color/color_222222"
                android:textSize="@dimen/sp_14"
                tools:text="他" />

            <View
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_20"
                android:background="@color/blackAlpha80" />

            <cn.yanhu.baselib.view.CustomFontTextView
                android:id="@+id/iv_addFriend"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="申请好友"
                android:textColor="@color/color_222222"
                android:textSize="@dimen/sp_14"
                android:visibility="@{userInfo.friend || (userInfo.sameGender &amp;&amp; AppCacheManager.isMan())?View.GONE:View.VISIBLE}" />

            <View
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_20"
                android:background="@color/blackAlpha80"
                android:visibility="@{userInfo.friend?View.GONE:View.VISIBLE}" />

            <cn.yanhu.baselib.view.CustomFontTextView
                android:id="@+id/iv_sendGift"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text='@{userInfo.gender==1?"送他礼物":"送她礼物"}'
                android:textColor="@color/color_222222"
                android:textSize="@dimen/sp_14"
                tools:text="送她礼物" />
        </LinearLayout>


        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/iv_avatar"
            imageUrl="@{userInfo.portrait}"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            android:src="@drawable/ease_default_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_border_color="@color/white"
            app:riv_border_width="@dimen/dp_1"
            app:riv_oval="true" />

        <!-- android:visibility="@{isSelf?View.INVISIBLE:View.VISIBLE}"-->
        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/svg_report_gray"
            android:gravity="center_vertical"
            android:padding="@dimen/dp_15"
            android:text="举报"
            android:textColor="@color/color_888888"
            android:textSize="@dimen/sp_12"
            android:visibility="@{isSelf?View.INVISIBLE:View.VISIBLE}"
            app:drawableTint="@color/color_888888"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/viewBg" />
        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_userDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/dp_15"
            android:text="查看主页"
            android:textColor="@color/color_888888"
            android:textSize="@dimen/sp_12"
            android:visibility="@{isSelf?View.INVISIBLE:View.VISIBLE}"
            app:drawableTint="@color/color_888888"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/viewBg" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>