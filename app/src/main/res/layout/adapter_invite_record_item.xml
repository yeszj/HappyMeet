<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="userinfo"
            type="cn.huanyuan.sweetlove.bean.InviteRecordInfo" />

        <import type="android.view.View" />

        <import type="cn.yanhu.baselib.utils.CommonUtils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_5"
        android:layout_marginBottom="@dimen/dp_10"
        android:background="@drawable/white_corner_10"
      >

        <cn.yanhu.commonres.view.UserAvatarView
            android:id="@+id/avatarView"
            avatarUrl="@{userinfo.portrait}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginStart="@dimen/dp_15"
            app:avatarSize="@dimen/dp_40"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:svgAvatarSize="@dimen/dp_40" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/svg_online_stoke_white"
            android:visibility="@{userinfo.online?View.VISIBLE:View.INVISIBLE}"
            app:layout_constraintBottom_toBottomOf="@+id/avatarView"
            app:layout_constraintEnd_toEndOf="@+id/avatarView" />

        <cn.yanhu.baselib.widget.FontWeightValueTextView
            android:id="@+id/tv_nickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"
            android:text="@{userinfo.nickName}"
            android:textColor="@color/fontTextColor"
            android:textSize="@dimen/sp_14"
            app:fontWeightValue="bold"
            app:layout_constraintStart_toEndOf="@+id/avatarView"
            app:layout_constraintTop_toTopOf="@+id/avatarView"
            tools:text="佊岸、花开" />



        <cn.yanhu.baselib.widget.FontWeightValueTextView
            android:id="@+id/tagId"
            android:text='@{"ID "+userinfo.userId}'
            android:textColor="@color/color6"
            android:layout_width="wrap_content"
            android:textSize="@dimen/sp_12"
            tools:text="ID 32323"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_5"
            app:layout_constraintBottom_toBottomOf="@+id/avatarView"
            app:layout_constraintStart_toEndOf="@+id/avatarView" />

        <com.lihang.ShadowLayout
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginHorizontal="@dimen/dp_15"
            app:hl_layoutBackground="#1AFFB039"
            app:hl_strokeWith="@dimen/dp_1"
            app:hl_strokeColor="#1AFFB039"
            app:hl_cornerRadius="@dimen/dp_5"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/main_alpha10_stroke_r8"
            app:layout_constraintTop_toBottomOf="@+id/avatarView" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_totalDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="累计收益(元)"
            android:textColor="@color/color_888888"
            android:textSize="@dimen/sp_12"
            app:layout_constraintTop_toBottomOf="@+id/tv_totalValue"
            app:layout_constraintEnd_toEndOf="@+id/divider"
            app:layout_constraintStart_toStartOf="@+id/divider"
            app:layout_constraintBottom_toBottomOf="@+id/divider" />

        <cn.yanhu.baselib.widget.FontWeightValueTextView
            android:id="@+id/tv_totalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{userinfo.totalIncome}'
            android:textColor="#FFB039"
            android:textSize="@dimen/sp_14"
            app:fontWeightValue="bold"
            app:layout_constraintEnd_toEndOf="@+id/divider"
            app:layout_constraintStart_toStartOf="@+id/divider"
            app:layout_constraintTop_toTopOf="@+id/divider"
            app:layout_constraintBottom_toTopOf="@+id/tv_totalDesc"
            tools:text="21.00" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_clearTips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/dp_10"
            android:paddingHorizontal="@dimen/dp_15"
            android:text='@{userinfo.showActiveTip?userinfo.activeDesc:userinfo.lastOnlineTime}'
            android:textColor="@{userinfo.showActiveTip?@color/bgOrangeColor:@color/fontGrayColor}"
            android:textSize="@dimen/sp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            tools:text=" 89天未活跃 邀请关系将在1天后失效"
            tools:textColor="@color/bgOrangeColor" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看详情"
            android:gravity="center_vertical"
            android:padding="@dimen/dp_10"
            android:textColor="@color/colorMain"
            android:textSize="@dimen/sp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_clearTips"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>