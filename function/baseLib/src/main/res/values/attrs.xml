<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="TitleBar">

        <attr name="titleName" format="string" />

        <attr name="titleRightName" format="string" />
        <attr name="titleLeftName" format="string" />
        <attr name="titleShowBackButton" format="boolean" />

        <attr name="titleRightIco" format="reference" />

        <attr name="titleRightDrawableLeft" format="boolean" />

        <attr name="titleLeftIco" format="reference" />

        <attr name="titleBgColor" format="color" />

        <attr name="titleColor" format="color" />

        <attr name="titleRightColor" format="color" />

        <attr name="titleNameIsbold" format="boolean" />
        <attr name="titleRightNameIsbold" format="boolean" />
        <attr name="titleRightLayoutId" format="reference" />
    </declare-styleable>

    <declare-styleable name="StrokeGradientTextView">
        <attr name="strokeColor" format="color" />
        <attr name="strokeEndColor" format="color" />
        <attr name="startColor" format="color" />
        <attr name="centerColor" format="color" />
        <attr name="endColor" format="color" />
        <attr name="gradientStrokeWidth" format="dimension" />
        <attr name="gradient_direction">
            <flag name="leftToRight" value="1" />
            <flag name="topToBottom" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="CustomFontTextView">
        <attr name="fontType" format="string" />
        <attr name="fontCustomStyle">
            <flag name="normal" value="0" />
            <flag name="bold" value="1" />
            <flag name="italic" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="BorderGradientView">
        <attr name="borderStartColor" format="color" />
        <attr name="borderEndColor" format="color" />
        <attr name="borderRadius" format="dimension" />
        <attr name="borderBgColor" format="color" />
        <attr name="borderViewWidth" format="dimension" />
        <attr name="borderBottomLeftRadius" format="dimension" />
        <attr name="borderBottomRightRadius" format="dimension" />
        <attr name="borderTopRightRadius" format="dimension" />
        <attr name="borderTopLeftRadius" format="dimension" />
        <attr name="borderGradientColors" format="dimension"/>
        <attr name="borderGradientType">
            <flag name="TOP_TO_BOTTOM" value="0" />
            <flag name="LEFT_TO_RIGHT" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="CustomTabLayout">
        <attr name="customSelectTextSize" format="dimension" />
        <attr name="customNormalTextSize" format="dimension" />
        <attr name="customSelectTextColor" format="color" />
        <attr name="customNormalTextColor" format="color" />
        <attr name="customSelectIsBold" format="boolean" />
        <attr name="customSelectBg" format="reference" />
        <attr name="customNormalBg" format="reference" />
        <attr name="showIconPosition" format="integer" />
    </declare-styleable>

    <declare-styleable name="MaxHeightView">
        <attr name="mhv_HeightRatio" format="reference|float" />
        <attr name="mhv_HeightDimen" format="reference|dimension" />
    </declare-styleable>
    <declare-styleable name="Verificationcode">
        <attr name="code_text_color" format="color" />
        <attr name="code_text_size" format="dimension" />
        <attr name="code_number" format="integer" />
        <attr name="line_color_default" format="color" />
        <attr name="line_color_focus" format="color" />
    </declare-styleable>

    <declare-styleable name="CustomFlowLayout">
        <attr name="fl_verticalSpacing" format="dimension" />
    </declare-styleable>


    <declare-styleable name="GradientViewGroup">
        <!-- 背景渐变起始颜色 -->
        <attr name="backgroundStartColor" format="color" />
        <!-- 背景渐变结束颜色 -->
        <attr name="backgroundEndColor" format="color" />
        <!-- 背景渐变方向 -->
        <attr name="backgroundGradientOrientation">
            <enum name="top_bottom" value="0" />
            <enum name="left_right" value="1" />
            <enum name="tr_bl" value="2" />
            <enum name="tl_br" value="3" />
        </attr>

        <!-- 边框宽度 -->
        <attr name="vg_borderWidth" format="dimension" />
        <!-- 边框渐变起始颜色 -->
        <attr name="vg_borderStartColor" format="color" />
        <!-- 边框渐变结束颜色 -->
        <attr name="vg_borderEndColor" format="color" />
        <!-- 边框渐变方向 -->
        <attr name="borderGradientOrientation">
            <enum name="top_bottom" value="0" />
            <enum name="left_right" value="1" />
            <enum name="tr_bl" value="2" />
            <enum name="tl_br" value="3" />
        </attr>

        <!-- 圆角半径 -->
        <attr name="cornerRadius" format="dimension" />
    </declare-styleable>

    <declare-styleable name="GradientTextView">
        <!-- 背景渐变起始颜色 -->
        <attr name="zj_tvStartColor" format="color" />
        <!-- 背景渐变结束颜色 -->
        <attr name="zj_tvEndColor" format="color" />
        <!-- 背景渐变方向 -->
        <attr name="zj_tvBgGradientOrientation">
            <enum name="top_bottom" value="0" />
            <enum name="left_right" value="1" />
            <enum name="tr_bl" value="2" />
            <enum name="tl_br" value="3" />
        </attr>

        <!-- 边框宽度 -->
        <attr name="zj_tvBorderWidth" format="dimension" />
        <!-- 边框渐变起始颜色 -->
        <attr name="zj_tvBorderStartColor" format="color" />
        <!-- 边框渐变结束颜色 -->
        <attr name="zj_tvBorderEndColor" format="color" />
        <!-- 边框渐变方向 -->
        <attr name="zj_tvBorderGradientOrientation">
            <enum name="top_bottom" value="0" />
            <enum name="left_right" value="1" />
            <enum name="tr_bl" value="2" />
            <enum name="tl_br" value="3" />
        </attr>

        <!-- 圆角半径 -->
        <attr name="zj_tvCornerRadius" format="dimension" />
    </declare-styleable>


    <declare-styleable name="FontWeightTextView">
        <attr name="android:textFontWeight" format="integer" />
        <attr name="textFontWeight" format="integer" />
    </declare-styleable>

    <declare-styleable name="FontWeightValueTextView">
        <attr name="fontWeightValue" format="enum">
            <enum name="thin" value="100" />"
            <enum name="extraLight" value="200" />"
            <enum name="light" value="300" />"
            <enum name="normal" value="400" />"
            <enum name="medium" value="500" />"
            <enum name="semiBold" value="600" />"
            <enum name="bold" value="700" />"
            <enum name="extraBold" value="800" />"
            <enum name="black" value="900" />"
        </attr>
    </declare-styleable>

    <declare-styleable name="GradientBorderCircleImageView">
        <!-- 边框宽度 -->
        <attr name="fl_borderWidth" format="dimension" />
        <!-- 边框渐变色起始颜色 -->
        <attr name="fl_borderStartColor" format="color" />
        <!-- 边框渐变色结束颜色 -->
        <attr name="fl_borderEndColor" format="color" />
    </declare-styleable>
</resources>