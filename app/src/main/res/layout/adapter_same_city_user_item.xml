<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="userinfo"
            type="cn.yanhu.commonres.bean.SameCityUserInfo" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/avatarView"
            imageUrl="@{userinfo.portrait}"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_12"
            android:src="@drawable/ease_default_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_oval="true" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_nickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:drawablePadding="@dimen/dp_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{userinfo.nickName}"
            android:textColor="@color/fontTextColor"
            android:textSize="@dimen/sp_15"
            app:fontType="@string/fontMedium"
            app:layout_constraintBottom_toTopOf="@+id/divider"
            app:layout_constraintStart_toEndOf="@+id/avatarView"
            app:layout_constraintTop_toTopOf="@+id/avatarView"
            tools:text="佊岸、花开" />

        <View
            android:id="@+id/divider"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_0_5"
            android:layout_marginTop="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="@+id/avatarView"
            app:layout_constraintStart_toEndOf="@+id/avatarView"
            app:layout_constraintTop_toTopOf="@+id/avatarView" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_14"
            android:layout_marginStart="@dimen/dp_4"
            android:gravity="center"
            android:src="@drawable/icon_new_user"
            android:visibility="@{userinfo.newUser?View.VISIBLE:View.INVISIBLE}"
            app:fontType="@string/fontMedium"
            app:layout_constraintBottom_toBottomOf="@+id/tv_nickName"
            app:layout_constraintStart_toEndOf="@+id/tv_nickName"
            app:layout_constraintTop_toTopOf="@+id/tv_nickName" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_userInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:text="@{userinfo.strUserInfo}"
            android:textColor="@color/cl_common"
            android:textSize="@dimen/sp_12"
            app:layout_constraintStart_toStartOf="@+id/tv_nickName"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            tools:text="女 | 32岁｜浙江｜老家黑龙江" />

        <LinearLayout
            android:id="@+id/vg_online"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_15"
            android:gravity="center_vertical"
            android:visibility="@{userinfo.online?View.VISIBLE:View.INVISIBLE}"
            app:layout_constraintBottom_toBottomOf="@+id/tv_nickName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_nickName">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/svg_online" />

            <cn.yanhu.baselib.view.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="在线"
                android:textColor="@color/color_666666"
                android:textSize="@dimen/sp_11" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_accost"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_gravity="right"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_16"
            android:src="@drawable/icon_accost"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vg_online"
            tools:visibility="visible" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/vg_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:background="@{userinfo.publicRoom?@drawable/bg_blinding_tag:(userinfo.privateRoom?@drawable/bg_private_tag:  @drawable/bg_friends_tag)}"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_7"
            android:text="@{userinfo.roomDesc}"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_11"
            app:fontType="@string/fontMedium"
            tools:text="交友中"
            android:paddingVertical="@dimen/dp_2"
            android:visibility="@{userinfo.roomId == 0? View.INVISIBLE : View.VISIBLE}"
            app:layout_constraintStart_toStartOf="@+id/avatarView"
            app:layout_constraintEnd_toEndOf="@+id/avatarView"
            app:layout_constraintTop_toBottomOf="@+id/avatarView"
            tools:background="@drawable/bg_blinding_tag"/>

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_intro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text='@{userinfo.description}'
            android:textColor="@color/fontGrayColor"
            android:paddingHorizontal="@dimen/dp_12"
            android:textSize="@dimen/sp_12"
            android:visibility="@{TextUtils.isEmpty(userinfo.description)?View.INVISIBLE:View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="@+id/vg_room"
            app:layout_constraintEnd_toStartOf="@+id/iv_accost"
            app:layout_constraintStart_toEndOf="@+id/avatarView"
            app:layout_constraintTop_toTopOf="@+id/vg_room"
            tools:text="你认真的样子，你认真的样子你认真的样子你认真的样子" />

        <View
            android:id="@+id/picGridLayout"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_0_5"
            android:layout_marginTop="@dimen/dp_12"
            android:background="#14000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vg_room" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>