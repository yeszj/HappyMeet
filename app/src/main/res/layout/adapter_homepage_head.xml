<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="userinfo"
            type="cn.yanhu.commonres.bean.UserDetailInfo" />

        <import type="android.view.View" />

        <import type="cn.yanhu.commonres.R" />

        <import type="android.text.TextUtils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_cover"
            imageUrl="@{userinfo.coverImg}"
            placeholderId="@{R.drawable.shape_bg_gray}"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_360"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/shape_bg_gray" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_online"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_22"
            android:layout_marginBottom="@dimen/dp_10"
            android:background="@drawable/white_corner_12"
            android:backgroundTint="@color/whiteAlpha40"
            android:drawableStart="@drawable/svg_online"
            android:gravity="center"
            android:paddingStart="@dimen/dp_5"
            android:paddingEnd="@dimen/dp_8"
            android:text="在线"
            android:textSize="@dimen/sp_12"
            android:visibility="@{userinfo.online?View.VISIBLE:View.INVISIBLE}"
            app:fontType="@string/fontMedium"
            app:layout_constraintBottom_toTopOf="@+id/rv_avatar"
            app:layout_constraintStart_toStartOf="@+id/rv_avatar" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_avatar"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_12"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="@id/iv_cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_nickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_22"
            android:gravity="center_vertical"
            android:text="@{userinfo.nickName}"
            android:textColor="@color/fontTextColor"
            android:textSize="@dimen/sp_17"
            app:fontType="@string/fontBold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_cover"
            tools:text="慢两排" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_2"
            android:src="@drawable/icon_realname"
            android:visibility="@{userinfo.auth?View.VISIBLE:View.INVISIBLE}"
            app:layout_constraintBottom_toBottomOf="@+id/tv_nickName"
            app:layout_constraintStart_toEndOf="@+id/tv_nickName"
            app:layout_constraintTop_toTopOf="@+id/tv_nickName" />

        <cn.yanhu.commonres.view.UserInfoTagLayout
            android:id="@+id/userTag"
            userInfo="@{userinfo}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_9"
            app:layout_constraintStart_toStartOf="@+id/tv_nickName"
            app:layout_constraintTop_toBottomOf="@+id/tv_nickName" />

        <cn.yanhu.commonres.view.UserIdTagLayout
            android:id="@+id/tagId"
            beautifulIdImg="@{userinfo.beautifulIdImg}"
            userId="@{userinfo.userId}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintStart_toStartOf="@+id/tv_nickName"
            app:layout_constraintTop_toBottomOf="@+id/userTag" />

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/iv_avatar1"
            imageUrl="@{userinfo.guardInfo.portrait}"
            placeholderId="@{-1}"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:scaleType="centerCrop"
            android:visibility="@{userinfo.showGuardInfo ?View.VISIBLE:View.INVISIBLE}"
            app:layout_constraintBottom_toBottomOf="@+id/iv_guardFrame"
            app:layout_constraintEnd_toEndOf="@+id/iv_guardFrame"
            app:layout_constraintStart_toStartOf="@+id/iv_guardFrame"
            app:layout_constraintTop_toTopOf="@+id/iv_guardFrame"
            app:riv_oval="true"
            tools:src="@drawable/icon_portrait" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_guardFrame"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:layout_marginEnd="@dimen/dp_5"
            android:visibility="@{userinfo.showGuardInfo ?View.VISIBLE:View.INVISIBLE}"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/dp_m_10"
            app:layout_constraintTop_toTopOf="@+id/tv_nickName"
            app:layout_constraintBottom_toBottomOf="@+id/tagId"
            tools:src="@drawable/avatar_frame_guard" />

        <LinearLayout
            android:id="@+id/vg_lovers"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:layout_marginHorizontal="@dimen/dp_12"
            android:layout_marginTop="@dimen/dp_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="@{userinfo.showLoverInfo ?View.VISIBLE:View.GONE}"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@+id/iv_guardFrame"
            android:background="@drawable/bg_lovers1_tag">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:layout_marginStart="@dimen/dp_8"
                android:src="@{userinfo.loverInfo.loversType==3?@drawable/icon_lovers3:userinfo.loverInfo.loversType==2?@drawable/icon_lovers2:userinfo.loverInfo.loversType==4?@drawable/icon_lovers4:@drawable/icon_lovers1}"
                tools:src="@drawable/icon_lovers2" />

            <cn.yanhu.baselib.view.CustomFontTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="@dimen/dp_5"
                android:text='@{TextUtils.isEmpty(userinfo.loverInfo.nickName)?"暂无CP":userinfo.loverInfo.loverDesc()}'
                android:textColor="@color/white"
                android:textSize="@dimen/sp_13"
                app:fontType="@string/fontMedium"
                tools:text="黄金CP" />

            <cn.yanhu.baselib.view.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/dp_15"
                android:text="@{userinfo.loverInfo.nickName}"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_13"
                tools:text="琼(舞)" />
        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginTop="@dimen/dp_20"
            android:background="@color/blackAlpha96"
            app:layout_constraintTop_toBottomOf="@+id/vg_lovers" />



        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_20"
            android:gravity="center_vertical"
            android:text="交友宣言"
            android:textColor="@color/fontGrayColor"
            android:textSize="@dimen/sp_14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:gravity="center_vertical"
            android:paddingEnd="@dimen/dp_10"
            android:text="@{userinfo.description}"
            android:textColor="@color/fontTextColor"
            android:textSize="@dimen/sp_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_desc"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc"
            tools:text="世上无难事只怕有钱人，物以类聚人以穷分。世上无难事只怕有钱人，物以类聚人以穷分。" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>