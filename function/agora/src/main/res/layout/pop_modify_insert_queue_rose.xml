<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_top_corner_15"
        android:paddingBottom="@dimen/dp_20">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_dismiss"
            android:layout_width="@dimen/dp_54"
            android:layout_height="@dimen/dp_54"
            android:padding="@dimen/dp_15"
            android:src="@drawable/svg_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重置插队玫瑰数"
            android:textColor="@color/cl_common"
            android:textSize="@dimen/sp_16"
            app:fontType="@string/fontBold"
            app:layout_constraintBottom_toBottomOf="@+id/iv_dismiss"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_dismiss" />

        <LinearLayout
            android:id="@+id/vg_price"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:background="@drawable/white_corner_12"
            android:backgroundTint="#0D1F1F23"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/iv_dismiss">

            <cn.yanhu.baselib.view.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="底价设置"
                android:textColor="@color/cl_common"
                android:textSize="@dimen/sp_14"
                app:fontType="@string/fontMedium" />

            <cn.yanhu.baselib.view.CustomFontEditText
                android:id="@+id/et_price"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/transparent"
                android:gravity="end|center_vertical"
                android:hint="请输入玫瑰数"
                android:paddingEnd="@dimen/dp_4"
                android:inputType="number"
                android:digits="1234567890"
                android:text="200"
                android:textColor="@color/cl_common"
                android:textColorHint="@color/fontGrayColor"
                android:textSize="@dimen/sp_20"
                app:fontType="@string/fontMedium" />

            <cn.yanhu.baselib.view.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="玫瑰"
                android:textColor="@color/cl_common"
                android:textSize="@dimen/sp_14"
                app:fontType="@string/fontMedium" />
        </LinearLayout>

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/dp_10"
            android:textColor="@color/color_666666"
            android:textSize="@dimen/sp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vg_price"
            tools:text="当前插队价格：200玫瑰" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_modify"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/shape_common_btn_r30"
            android:gravity="center"
            android:text="确定重置"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_17"
            app:fontType="@string/fontBold"
            app:layout_constraintTop_toBottomOf="@+id/tv_price" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/dp_10"
            android:textColor="@color/color_666666"
            android:textSize="@dimen/sp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_modify"
            tools:text="确定后，本轮插队数将清零" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>