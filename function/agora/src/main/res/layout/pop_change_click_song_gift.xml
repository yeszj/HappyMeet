<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_top_corner_10"
        android:backgroundTint="#161727"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp_24">

        <cn.yanhu.baselib.view.CustomFontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/dp_20"
            android:text="更换点歌礼物"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            app:fontType="@string/fontMedium" />

        <!--    <cn.yanhu.baselib.view.CustomFontTextView-->
        <!--        android:layout_width="wrap_content"-->
        <!--        android:layout_height="wrap_content"-->
        <!--        android:paddingTop="@dimen/dp_8"-->
        <!--        android:text="更换后"-->
        <!--        android:textColor="@color/whiteColorAlpha60"-->
        <!--        android:textSize="@dimen/sp_13" />-->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_gift"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_306"
            android:layout_marginTop="@dimen/dp_24"
            android:fadingEdgeLength="@dimen/dp_40"
            android:paddingHorizontal="@dimen/dp_5"
            android:requiresFadingEdge="vertical"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="4"
            tools:listitem="@layout/adapter_gift_select_item" />

        <cn.yanhu.baselib.view.CustomFontTextView
            android:id="@+id/tv_change"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_5"
            android:background="@drawable/shape_common_btn_r30"
            android:gravity="center"
            android:text="确认更换"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_17"
            app:fontType="@string/fontBold" />

    </LinearLayout>
</layout>