<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="bean"
            type="cn.huanyuan.sweetlove.bean.GlobalGiftBean" />

        <import type="cn.yanhu.commonres.bean.GiftInfo" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_100"
        android:layout_marginTop="@dimen/dp_60">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp_360"
            android:layout_height="@dimen/dp_100"
            android:layout_marginStart="@dimen/dp_15"
            android:src="@{bean.showType==0?@drawable/global_gift_style1:@drawable/global_gift_style2}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/global_gift_style2" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/vg_avatar"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="@{bean.showType==1?View.GONE:View.VISIBLE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/fromFrame"
                    android:layout_width="@dimen/dp_62"
                    android:layout_height="@dimen/dp_62"
                    android:src="@mipmap/slide_frame"
                    android:visibility="@{bean.showType==0?View.VISIBLE:View.INVISIBLE}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/from_portrait"
                    imageUrl="@{bean.fromThumbPortrait}"
                    android:layout_width="@dimen/dp_35"
                    android:layout_height="@dimen/dp_35"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ease_default_avatar"
                    app:layout_constraintBottom_toBottomOf="@+id/fromFrame"
                    app:layout_constraintEnd_toEndOf="@+id/fromFrame"
                    app:layout_constraintStart_toStartOf="@+id/fromFrame"
                    app:layout_constraintTop_toTopOf="@+id/fromFrame"
                    app:riv_oval="true" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/vg_two"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:visibility="@{bean.showType==1?View.VISIBLE:View.GONE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_31"
                    android:layout_height="@dimen/dp_39"
                    android:layout_marginTop="@dimen/dp_23"
                    android:src="@drawable/global_gift_left"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_frame1"
                    android:layout_width="@dimen/dp_38"
                    android:layout_height="@dimen/dp_38"
                    android:layout_marginStart="@dimen/dp_18"
                    android:src="@drawable/global_avatar_frame"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/iv_avatar1"
                    imageUrl="@{bean.fromThumbPortrait}"
                    android:layout_width="@dimen/dp_27"
                    android:layout_height="@dimen/dp_27"

                    app:layout_constraintBottom_toBottomOf="@+id/iv_frame1"
                    app:layout_constraintEnd_toEndOf="@+id/iv_frame1"
                    app:layout_constraintStart_toStartOf="@+id/iv_frame1"
                    app:layout_constraintTop_toTopOf="@+id/iv_frame1"
                    app:riv_oval="true"
                    tools:src="@drawable/ease_default_avatar" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_31"
                    android:layout_height="@dimen/dp_39"
                    android:layout_marginStart="@dimen/dp_m_12"
                    android:layout_marginTop="@dimen/dp_23"
                    android:layout_marginEnd="@dimen/dp_m_20"
                    android:src="@drawable/global_gift_right"
                    app:layout_constraintStart_toEndOf="@+id/iv_frame2"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_frame2"
                    android:layout_width="@dimen/dp_38"
                    android:layout_height="@dimen/dp_38"
                    android:layout_marginStart="@dimen/dp_m_10"
                    android:src="@drawable/global_avatar_frame"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_avatar1"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.makeramen.roundedimageview.RoundedImageView
                    imageUrl="@{bean.toThumbPortrait}"
                    android:layout_width="@dimen/dp_27"
                    android:layout_height="@dimen/dp_27"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_frame2"
                    app:layout_constraintEnd_toEndOf="@+id/iv_frame2"
                    app:layout_constraintStart_toStartOf="@+id/iv_frame2"
                    app:layout_constraintTop_toTopOf="@+id/iv_frame2"
                    app:riv_oval="true"
                    tools:src="@drawable/ease_default_avatar" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <cn.yanhu.baselib.widget.FontWeightValueTextView
            android:id="@+id/tv_fromNickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLength="4"
            app:fontWeightValue="medium"
            android:maxLines="1"
            android:text='@{bean.fromUserNickName}'
            android:textColor='@{bean.showType==1?@color/black:@color/sendNameColor}'
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="@+id/vg_avatar"
            app:layout_constraintStart_toEndOf="@+id/vg_avatar"
            app:layout_constraintTop_toTopOf="@+id/vg_avatar"
            tools:text="恰同学少年恰同学少年" />

        <cn.yanhu.baselib.widget.FontWeightValueTextView
            android:id="@+id/tv_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 送给 "
            android:textColor="@color/white"
            app:fontWeightValue="medium"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="@+id/vg_avatar"
            app:layout_constraintStart_toEndOf="@+id/tv_fromNickName"
            app:layout_constraintTop_toTopOf="@+id/vg_avatar" />

        <cn.yanhu.baselib.widget.FontWeightValueTextView
            android:id="@+id/tv_toNickName"
            app:fontWeightValue="medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLength="4"
            android:maxLines="1"
            android:text='@{bean.toUserNickName}'
            android:textColor='@{bean.showType==1?@color/black:@color/receiveNameColor}'
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="@+id/vg_avatar"
            app:layout_constraintStart_toEndOf="@+id/tv_tag"
            app:layout_constraintTop_toTopOf="@+id/vg_avatar"
            tools:text="恰同学恰同学" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_giftIcon"
            imageUrl="@{bean.giftIcon}"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_60"
            android:layout_marginTop="@dimen/dp_5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <cn.yanhu.baselib.widget.FontWeightValueTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#80440020"
            android:text="@{bean.giftType==GiftInfo.TYPE_RANDOM_BOX?(` `+bean.giftName+` 价值`+bean.giftPrice+`玫瑰`):(` `+bean.giftName+`x`+bean.giftNum)}"
            android:textColor="@color/white"
            app:fontWeightValue="medium"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="@+id/vg_avatar"
            app:layout_constraintStart_toEndOf="@+id/tv_toNickName"
            app:layout_constraintTop_toTopOf="@+id/vg_avatar"
            tools:text=" 恋恋风尘x1" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>